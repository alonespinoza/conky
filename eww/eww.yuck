;; ─── Instrument HUD (eww / Wayland layer-shell) ─────────────────────────────
(defpoll temp   :interval "3s"   :initial "0"
  "~/.config/eww/scripts/temp")
(defpoll upt    :interval "30s"  :initial "…"
  "~/.config/eww/scripts/uptime")
(defpoll net    :interval "1s"
  :initial '{"iface":"—","ssid":"","sig":0,"down":"0","du":" KB/s","up":"0","uu":" KB/s","up_hist":[2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2],"dn_hist":[2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2]}'
  "~/.config/eww/scripts/net")
(defpoll wthr   :interval "900s" :initial '{"temp":"--°","icon":"","desc":""}'
  "~/.config/eww/scripts/weather")
(defpoll music  :interval "1s"   :initial '{"playing":false,"title":"","artist":"","posf":"","lenf":"","pct":0}'
  "~/.config/eww/scripts/music")
(defpoll disks  :interval "30s"
  :initial '{"root":{"pct":0,"used":"-","free":"-","total":"-"},"home":{"pct":0,"used":"-","free":"-","total":"-"}}'
  "~/.config/eww/scripts/disks")
(defpoll batt   :interval "10s"
  :initial '{"pct":0,"state":"","glyph":"","foot":"…","col":"#9db4c0"}'
  "~/.config/eww/scripts/battery")
(defpoll audio  :interval "1s"
  :initial '{"vol":0,"vmut":false,"mic":0,"mmut":false}'
  "~/.config/eww/scripts/audio")
(defpoll datestr :interval "300s" :initial ""
  "date +'%a %d %b' | tr '[:lower:]' '[:upper:]'")

(defwidget ring [value col lbl unit]
  (box :orientation "v" :space-evenly false :spacing 5 :halign "center"
    (box :class "ring-slot" :halign "center" :valign "center"
      (overlay
        (circular-progress :class "ring" :value {value <= 100 ? value : 100}
                           :thickness 6 :start-at 75 :clockwise true
                           :hexpand true :vexpand true
                           :style "color: ${col};")
        (label :class "ringnum" :text "${round(value,0)}${unit}")))
    (label :class "lbl" :text lbl)))

;; mirrored network spectrum: upload rises above the centerline, download drops
;; below; newest sample on the right, heights come from the net script (1..18px).
(defwidget spectrum [up dn]
  (box :orientation "v" :space-evenly false :class "spectrum"
    (box :class "spec-top" :space-evenly false :spacing 1 :valign "end"
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[0]}px; opacity: 0.28;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[1]}px; opacity: 0.30;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[2]}px; opacity: 0.32;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[3]}px; opacity: 0.34;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[4]}px; opacity: 0.35;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[5]}px; opacity: 0.37;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[6]}px; opacity: 0.39;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[7]}px; opacity: 0.41;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[8]}px; opacity: 0.43;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[9]}px; opacity: 0.45;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[10]}px; opacity: 0.46;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[11]}px; opacity: 0.48;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[12]}px; opacity: 0.50;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[13]}px; opacity: 0.52;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[14]}px; opacity: 0.54;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[15]}px; opacity: 0.56;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[16]}px; opacity: 0.58;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[17]}px; opacity: 0.59;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[18]}px; opacity: 0.61;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[19]}px; opacity: 0.63;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[20]}px; opacity: 0.65;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[21]}px; opacity: 0.67;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[22]}px; opacity: 0.69;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[23]}px; opacity: 0.70;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[24]}px; opacity: 0.72;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[25]}px; opacity: 0.74;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[26]}px; opacity: 0.76;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[27]}px; opacity: 0.78;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[28]}px; opacity: 0.80;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[29]}px; opacity: 0.82;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[30]}px; opacity: 0.83;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[31]}px; opacity: 0.85;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[32]}px; opacity: 0.87;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[33]}px; opacity: 0.89;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[34]}px; opacity: 0.91;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[35]}px; opacity: 0.93;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[36]}px; opacity: 0.94;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[37]}px; opacity: 0.96;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up" :style "min-height: ${up[38]}px; opacity: 0.98;")
        (box :hexpand true :vexpand false :valign "end" :class "sb-up sb-head-up" :style "min-height: ${up[39]}px; opacity: 1.00;")
    )
    (box :class "spec-mid")
    (box :class "spec-bot" :space-evenly false :spacing 1 :valign "start"
        (box :hexpand true :vexpand false :valign "start" :class "sb-dn" :style "min-height: ${dn[0]}px; opacity: 0.28;")
        (box :hexpand true :vexpand false :valign "start" :class "sb-dn" :style "min-height: ${dn[1]}px; opacity: 0.30;")
        (box :hexpand true :vexpand false :valign "start" :class "sb-dn" :style "min-height: ${dn[2]}px; opacity: 0.32;")
        (box :hexpand true :vexpand false :valign "start" :class "sb-dn" :style "min-height: ${dn[3]}px; opacity: 0.34;")
